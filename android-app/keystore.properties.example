# Copy this file to keystore.properties (same directory) and fill in the
# real values. keystore.properties is gitignored — never commit it or the
# .jks file it points to. Use an absolute path for storeFile so it works
# regardless of which directory Gradle is invoked from; keep the .jks
# somewhere outside the repo entirely (e.g. your user home folder), not
# inside android-app/.
storeFile=C:/Users/dimit/keystores/watchtower-release.jks
storePassword=changeme
keyAlias=watchtower
keyPassword=changeme
